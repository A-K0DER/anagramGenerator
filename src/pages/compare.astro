---
import Layout from '../layouts/Layout.astro';
import { SITE, ALTERNATIVES } from '../config';

const rows = [
  { feature: 'Where your text is processed', us: 'In your browser; never uploaded', check: 'Read the site’s privacy policy to see whether searches are sent to a server' },
  { feature: 'Multi-word anagrams', us: 'Yes, 1 to 10 words per result', check: 'Look for a max-words setting' },
  { feature: 'Must include / never include words', us: 'Yes', check: 'Useful for steering results to a theme' },
  { feature: 'Minimum word length and result cap', us: 'Yes', check: 'Keeps results readable' },
  { feature: 'Common-words mode', us: 'Yes (about 15,000 everyday words, or the full 274,000)', check: 'Avoids obscure words in results' },
  { feature: 'Word finder (Scrabble-style) with starts/ends with', us: 'Yes', check: 'Handy for word games' },
  { feature: 'Anagram checker for two phrases', us: 'Yes', check: 'Confirms a rearrangement is exact' },
  { feature: 'Copy, TXT/CSV export, shareable link', us: 'Yes', check: 'Saves and reuses a search' },
  { feature: 'History and favorites', us: 'Yes, stored on your device only', check: 'Check where they are stored' },
  { feature: 'Account or sign-up needed', us: 'No', check: 'Check before you enter anything' },
];

const alternatives = [
  {
    name: 'Internet Anagram Server (wordsmith.org)',
    href: 'https://wordsmith.org/anagram/',
    body: 'A long-running classic from Wordsmith.org. It has an advanced search page, an anagram checker, an animation page and a Hall of Fame of notable anagrams. A good pick if you enjoy the history and culture of anagrams.',
  },
  {
    name: 'Dictionary.com and Thesaurus.com',
    href: ALTERNATIVES[1].href,
    body: 'Large dictionary brands such as Dictionary.com and Thesaurus.com offer anagram solvers alongside definitions and word-game tools, which helps if you want a meaning right next to each word.',
  },
];
---

<Layout title="Compare Anagram Solvers" description="How anagramGenerator compares with other anagram solvers: privacy, multi-word results, filters, word finder and export. Pick the right tool for your puzzle.">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-24">
    <p class="eyebrow">Compare</p>
    <h1 class="display-xl mt-3 !text-4xl sm:!text-5xl">Choosing an anagram solver</h1>
    <p class="mt-5 text-base leading-6 text-body">
      There are many good anagram tools, and the best one depends on what you are doing. This page shows what {SITE.name} offers, what to look for in any solver, and a few well-known alternatives worth trying.
    </p>

    <section class="mt-12">
      <h2 class="heading-md">What to look for</h2>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-xl border-collapse text-left text-sm">
          <caption class="sr-only">Feature comparison</caption>
          <thead>
            <tr class="border-b border-hairline">
              <th scope="col" class="py-3 pr-4 eyebrow">Feature</th>
              <th scope="col" class="py-3 pr-4 eyebrow" translate="no">{SITE.name}</th>
              <th scope="col" class="py-3 eyebrow">What to check elsewhere</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr class="border-b border-hairline align-top">
                  <th scope="row" class="py-3 pr-4 font-semibold text-ink">{r.feature}</th>
                  <td class="py-3 pr-4 text-body">{r.us}</td>
                  <td class="py-3 text-body">{r.check}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="heading-md">Where we fit</h2>
      <p class="mt-2 text-sm leading-6 text-body">
        We focus on private, fast, multi-word anagrams with detailed filters, plus a word finder and checker in the same place. We do not offer definitions or word-game scoring, so if you need those, one of the tools below may suit you better.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="heading-md">Other tools worth a look</h2>
      <ul class="mt-3 grid gap-4">
        {
          alternatives.map((a) => (
            <li class="card p-4">
              <h3 class="text-sm font-semibold text-ink">
                <a class="text-link underline-offset-2 hover:underline" href={a.href} rel="noopener">{a.name}</a>
              </h3>
              <p class="mt-2 text-sm leading-6 text-body">{a.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-xs leading-5 text-mute">
        Other sites’ features change, so check their pages for current details. All names belong to their respective owners, and we are not affiliated with them. Spot something out of date? <a class="text-link underline-offset-2 hover:underline" href="/contact">Tell us</a>.
      </p>
    </section>

    <div class="mt-12">
      <a href="/#tool" class="pill">Try the anagram generator</a>
    </div>
  </div>
</Layout>
