---
import Layout from '../layouts/Layout.astro';

const links = [
  { href: '/', label: 'Anagram Generator' },
  { href: '/anagram-solver', label: 'Anagram Solver' },
  { href: '/word-finder', label: 'Word Finder' },
  { href: '/anagram-checker', label: 'Anagram Checker' },
];
---

<Layout title="Page not found" description="The page you were looking for could not be found." noindex>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-24">
    <p class="eyebrow">Error 404</p>
    <h1 class="display-xl mt-3 !text-4xl sm:!text-5xl">Page not found</h1>
    <p class="mt-5 text-base leading-6 text-body">
      That page doesn’t exist or may have moved. Try one of the tools below, or head back to the homepage.
    </p>
    <ul class="mt-8 flex flex-wrap gap-3">
      {links.map((l) => <li><a href={l.href} class="pill">{l.label}</a></li>)}
    </ul>
  </div>
</Layout>
