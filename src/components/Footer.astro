---
import { SITE, ALTERNATIVES } from '../config';

const year = new Date().getFullYear();
const groups = [
  {
    title: 'Tools',
    links: [
      { href: '/?mode=anagram#tool', label: 'Anagram Generator' },
      { href: '/?mode=words#tool', label: 'Word Finder' },
      { href: '/?mode=pair#tool', label: 'Anagram Checker' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { href: '/#features', label: 'Features' },
      { href: '/#faq', label: 'FAQ' },
      { href: '/compare', label: 'Compare Solvers' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about', label: 'About Us' },
      { href: '/contact', label: 'Contact Us' },
      { href: '/contact#support', label: 'Support' },
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms & Conditions' },
    ],
  },
];
---

<footer class="border-t border-hairline">
  <div class="mx-auto grid max-w-300 gap-10 px-4 py-16 sm:grid-cols-[1.5fr_1fr_1fr_1fr_1.2fr] sm:px-6">
    <div>
      <p class="text-[15px] font-semibold tracking-tight text-ink" translate="no">{SITE.name}</p>
      <p class="mt-2 max-w-xs text-sm text-body">{SITE.tagline} Fast, private and free, with no sign-up.</p>
    </div>
    {
      groups.map((g) => (
        <nav aria-label={g.title}>
          <p class="eyebrow">{g.title}</p>
          <ul class="mt-3 space-y-2 text-sm">
            {g.links.map((l) => (
              <li>
                <a href={l.href} class="text-body transition-colors hover:text-ink">{l.label}</a>
              </li>
            ))}
            {g.title === 'Company' && (
              <li>
                <button type="button" data-cookie-settings class="text-body transition-colors hover:text-ink">Cookie settings</button>
              </li>
            )}
          </ul>
        </nav>
      ))
    }
    <nav aria-label="Other anagram solvers">
      <p class="eyebrow">Other solvers</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          ALTERNATIVES.map((a) => (
            <li>
              <a href={a.href} rel="noopener" class="text-body transition-colors hover:text-ink">{a.name}</a>
            </li>
          ))
        }
        <li>
          <a href="/compare" class="text-body transition-colors hover:text-ink">Compare all</a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-hairline">
    <p class="mx-auto max-w-300 px-4 py-6 text-xs text-mute sm:px-6">
      © {year} <span translate="no">{SITE.name}</span>. Your text never leaves your browser.
    </p>
  </div>
</footer>
