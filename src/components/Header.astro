---
import { SITE } from '../config';

const path = Astro.url.pathname;
const links = [
  { href: '/#tool', label: 'Generator' },
  { href: '/#features', label: 'Features' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/about', label: 'About' },
];
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas/85 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-300 items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-[15px] font-semibold tracking-tight text-ink" translate="no">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 8h13m0 0-3.5-3.5M17 8l-3.5 3.5M20 16H7m0 0 3.5-3.5M7 16l3.5 3.5"></path>
      </svg>
      {SITE.name}
    </a>
    <nav aria-label="Primary" class="flex items-center gap-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href ? 'page' : undefined}
            class="hidden rounded-full px-3 py-2 text-sm text-body transition-colors hover:bg-hairline-soft hover:text-ink aria-[current=page]:text-ink sm:inline-block"
          >
            {l.label}
          </a>
        ))
      }
      <button type="button" id="theme-toggle" class="btn btn-icon ml-1" aria-label="Toggle dark mode">
        <svg viewBox="0 0 24 24" class="size-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg viewBox="0 0 24 24" class="hidden size-4 dark:block" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
      <a href="/#tool" class="btn btn-primary ml-1">Try It Free</a>
    </nav>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#14102b' : '#fdf3dc');
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>
